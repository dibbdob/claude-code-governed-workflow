{
  "description": "Hold the plugin's read-only subagents to read-only Bash commands.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/read_only_bash.py\" --by-agent-type || exit 2"
          }
        ]
      }
    ]
  }
}
